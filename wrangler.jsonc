{
  // Assets-only Worker. No main script. Workers Builds deploy command stays `npx wrangler deploy`.
  "name": "kiln",
  "compatibility_date": "2026-11-28",
  "assets": {
    "directory": "./public",
    "not_found_handling": "none"
  },
  "build": {
    "command": "sh scripts/cloudflare-build.sh"
  }
}
